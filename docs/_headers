# Cloudflare Pages — response headers.
# `/_headers` applies security headers to every page and long caching to the
# fingerprinted static assets. Paths match the request path, not the file.

# Security headers for every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# Fingerprinted build assets — immutable, cache for a year.
/admin/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static assets (fonts, images, scripts, styles) — cache for a week.
/assets/*
  Cache-Control: public, max-age=604800

# The HTML shell — revalidate so content updates ship immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
