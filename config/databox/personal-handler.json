{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^1.0.0/components/context.jsonld",
  "@graph": [
    {
      "comment": "Personal Databox person-facing surface (CIV-A07): connection registry, credential install target, notify-then-pull vault sync, scoped submission. Ordered before the catch-all LDP handler. Authenticates to the owner's WebID — never a shared bearer token.",
